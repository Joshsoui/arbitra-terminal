{
  "name": "arbitra-terminal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backtest:propagation": "tsx scripts/run-propagation-backtest.ts",
    "trends:discover": "tsx scripts/discover-google-trends.ts",
    "trends:qualify": "tsx scripts/qualify-google-candidates.ts",
    "trends:import": "tsx scripts/import-trend-candidates.ts",
    "candidates:promote": "tsx scripts/promote-candidates.ts",
    "ingest:daily": "tsx scripts/discover-google-trends.ts && tsx scripts/import-trend-candidates.ts data/generated/google-trends-observations.json && tsx scripts/qualify-google-candidates.ts data/generated/google-trends-observations.json --persist && tsx scripts/promote-candidates.ts"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^7.9.4",
    "@supabase/supabase-js": "^2.45.4",
    "lucide-react": "^0.468.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.4"
  }
}
